#!/usr/bin/env -S uv run --script
#
# /// script
# dependencies = [
#   "inquirer",
#   "mastodon-py",
#   "tqdm",
# ]
# ///
import inquirer

from utils import (
    BLOCK_TAGS,
    block_instance,
    get_working_mastodon,
    normalize_instance,
    print_instance_stats,
)


def main():
    answers = inquirer.prompt(
        [
            inquirer.Text(name="instance", message="Instance URL"),
            inquirer.List(
                name="action",
                message="Block level",
                choices=(
                    ("Block", "block"),
                    ("Limit", "limit"),
                ),
                default="Block",
            ),
        ]
    )
    answers["instance"] = normalize_instance(answers["instance"])

    mastodon = None
    if answers["action"] == "block":
        mastodon = get_working_mastodon()
        print_instance_stats(answers["instance"], mastodon)
        if not inquirer.confirm(f"Block {answers['instance']}?", default=False):
            print("Aborted.")
            return

    questions = [
        inquirer.Checkbox(
            name="tags", message="Categories", choices=BLOCK_TAGS, carousel=True
        ),
        inquirer.Text(
            name="receipts",
            message="Receipts, optional (comma-separated for multiple)",
            default="",
        ),
        inquirer.Text(
            name="comment_en", message="Comment (English, optional)", default=""
        ),
    ]
    answers.update(inquirer.prompt(questions))
    if answers.get("comment_en").strip():
        answers["comment_de"] = inquirer.text(message="Comment (German)")
    else:
        answers["comment_de"] = ""

    for key in ("instance", "comment_en", "comment_de"):
        answers[key] = answers[key].strip()

    answers["receipts"] = [
        r.strip() for r in answers["receipts"].split(",") if r.strip()
    ]

    try:
        block_instance(mastodon=mastodon, **answers)
    except Exception as e:
        print(f"Error: {e}")


if __name__ == "__main__":
    main()
